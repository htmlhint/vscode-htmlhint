{
  "name": "htmlhint-server",
  "version": "1.0.0",
  "private": true,
  "description": "HTMLHint Linter Server",
  "scripts": {
    "compile": "tsc --noEmit -p ./src && node ../htmlhint/esbuild.js --server",
    "watch": "node ../htmlhint/esbuild.js --server --watch"
  },
  "dependencies": {
    "htmlhint": "^1.9.2",
    "ignore": "^7.0.5",
    "strip-json-comments": "3.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "vscode-uri": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "*"
  }
}
